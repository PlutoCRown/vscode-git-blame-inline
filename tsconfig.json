{
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "lib": [
            "ES2022"
        ],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "bundler",
        "types": [
            "node"
        ],
        "resolveJsonModule": true,
        "noEmit": true,
        "declaration": false,
        "sourceMap": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "gitlens-reference",
        "vscode-git-graph/**"
    ]
}